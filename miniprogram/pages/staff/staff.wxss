.page { min-height:100vh; background:#f6f7f9; padding-bottom:140rpx; }
.loading { text-align:center; color:#999; padding:120rpx 0; }
.header { font-size:34rpx; font-weight:600; color:#222; padding:36rpx 32rpx 20rpx; }
.empty { text-align:center; padding:160rpx 40rpx; }
.empty-icon { width:120rpx; height:120rpx; line-height:120rpx; border-radius:50%; background:#eee; color:#bbb; font-size:48rpx; margin:0 auto 24rpx; }
.empty-text { color:#888; font-size:28rpx; }
.empty-sub { color:#aaa; font-size:23rpx; margin-top:16rpx; line-height:1.6; }
.empty-inline { text-align:center; color:#999; font-size:26rpx; padding:80rpx 0; }
.order { background:#fff; margin:0 24rpx 20rpx; border-radius:16rpx; padding:28rpx; }
.order-head { display:flex; justify-content:space-between; align-items:center; }
.goods { font-size:30rpx; font-weight:600; color:#333; }
.status { font-size:23rpx; padding:6rpx 14rpx; border-radius:20rpx; }
.status-paid { color:#ff8c00; background:#fff5e6; }
.status-verified { color:#07C160; background:#e8f8ee; }
.status-cancelled { color:#999; background:#f2f2f2; }
.status-cancel_processing { color:#e64545; background:#fdecec; }
.info { font-size:24rpx; color:#888; margin-top:12rpx; }
.actions { display:flex; gap:20rpx; margin-top:24rpx; }
.btn-verify, .btn-cancel { flex:1; text-align:center; padding:20rpx; border-radius:10rpx; font-size:27rpx; }
.btn-verify { background:#07C160; color:#fff; }
.btn-cancel { background:#f5f5f5; color:#666; }
