.page { min-height:100vh; background:#f6f7f9; padding-bottom:60rpx; }
.loading { text-align:center; color:#999; padding:120rpx 0; }
.status-banner { background:#fff; padding:44rpx 40rpx; }
.status-title { font-size:40rpx; font-weight:600; color:#222; }
.status-sub { font-size:26rpx; color:#888; margin-top:12rpx; }
.card { background:#fff; margin:20rpx 24rpx 0; border-radius:16rpx; padding:30rpx; }
.section-title { font-size:28rpx; font-weight:600; color:#333; margin-bottom:22rpx; }
.code-placeholder { text-align:center; background:#f0faf4; color:#07C160; padding:36rpx; border-radius:12rpx; font-size:28rpx; border:2rpx dashed #07C160; }
.pay-btn { margin-top:20rpx; text-align:center; background:#07C160; color:#fff; font-size:30rpx; font-weight:600; padding:26rpx; border-radius:12rpx; }
.verify-code { text-align:center; font-size:52rpx; font-weight:700; letter-spacing:10rpx; color:#07C160; padding:18rpx 0 8rpx; }
.qr-box { display:flex; flex-direction:column; align-items:center; background:#f0faf4; border-radius:12rpx; padding:28rpx 0 20rpx; }
.qr-canvas { width:220px; height:220px; background:#fff; border-radius:8rpx; }
.qr-meta { display:flex; align-items:center; gap:24rpx; margin-top:14rpx; }
.qr-expire { font-size:23rpx; color:#8a8f99; }
.qr-refresh { font-size:24rpx; color:#07C160; padding:4rpx 20rpx; border:2rpx solid #07C160; border-radius:24rpx; }
.hint { font-size:22rpx; color:#aaa; margin-top:16rpx; }
.row { display:flex; justify-content:space-between; font-size:27rpx; color:#555; padding:14rpx 0; }
.row text:last-child { color:#333; }
.red { color:#e64545 !important; font-weight:600; }
.green { color:#07C160 !important; }
.link-card { display:flex; justify-content:space-between; align-items:center; font-size:28rpx; color:#333; }
.arrow { font-size:40rpx; color:#ccc; }
.notice { font-size:22rpx; color:#aaa; margin:30rpx 40rpx; line-height:1.6; }
