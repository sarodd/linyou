<view class="page">
  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <block wx:if="{{!loading && order}}">
    <view class="status-banner">
      <view class="status-title">{{order.statusText}}</view>
      <view wx:if="{{order.status === 'paid'}}" class="status-sub">请到店出示核销码提货</view>
      <view wx:if="{{order.status === 'verified'}}" class="status-sub">已核销，感谢购买</view>
    </view>

    <view class="card" wx:if="{{order.status === 'paid'}}">
      <view class="section-title">核销码</view>
      <view wx:if="{{!verifyCode}}" class="code-placeholder" bindtap="genCode">点击生成核销码（5分钟有效）</view>
      <view wx:if="{{verifyCode}}" class="verify-code">{{verifyCode}}</view>
      <view class="hint">到店后向店员出示此码核销，核销只可成功一次</view>
    </view>

    <view class="card">
      <view class="section-title">订单信息</view>
      <view class="row"><text>商品</text><text>{{order.goodsName}} · {{order.spec}}</text></view>
      <view class="row"><text>订单号</text><text>{{order.orderNo}}</text></view>
      <view class="row"><text>指定门店</text><text>{{order.storeName}}</text></view>
      <view class="row"><text>实付金额</text><text class="red">¥ {{order.amountYuan}}</text></view>
      <view class="row"><text>支付时间</text><text>{{order.paidText}}</text></view>
    </view>

    <view class="card" wx:if="{{commission}}">
      <view class="section-title">活动佣金</view>
      <view class="row"><text>金额</text><text class="green">¥ {{commission.amountYuan}}</text></view>
      <view class="row"><text>状态</text><text>{{commission.statusText}}</text></view>
      <view class="row"><text>方式</text><text>原订单实付款原路返还</text></view>
    </view>

    <view class="card link-card" wx:if="{{invitation}}" bindtap="goInvite">
      <text>查看邀请进度与邀请码</text><text class="arrow">›</text>
    </view>

    <view class="notice" wx:if="{{order.status === 'paid'}}">未核销商品取消，须到原订单指定门店办理退款，无线上自助入口</view>
  </block>
</view>
