.page { min-height:100vh; background:#f6f7f9; padding:60rpx 24rpx; }
.card { background:#fff; border-radius:16rpx; padding:48rpx 36rpx; text-align:center; }
.avatar { width:100rpx; height:100rpx; line-height:100rpx; border-radius:50%; background:#e8f8ee; color:#07C160; font-size:44rpx; margin:0 auto 24rpx; }
.title { font-size:34rpx; font-weight:600; color:#222; }
.sub { font-size:26rpx; color:#888; margin-top:16rpx; line-height:1.6; }
.code-row { margin-top:32rpx; background:#f0faf4; border:2rpx dashed #07C160; padding:24rpx; border-radius:12rpx; display:flex; justify-content:center; align-items:center; gap:20rpx; }
.code-label { font-size:24rpx; color:#888; }
.code { font-size:40rpx; font-weight:700; letter-spacing:4rpx; color:#07C160; }
.tips { margin:30rpx 12rpx; }
.tip { font-size:24rpx; color:#777; line-height:2; }
.btn-primary { background:#07C160; color:#fff; text-align:center; font-size:32rpx; padding:26rpx; border-radius:12rpx; margin-top:20rpx; }
.btn-ghost { text-align:center; font-size:28rpx; color:#888; padding:26rpx; }
