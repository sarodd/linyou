.page { min-height: 100vh; background: #F6F7F9; padding-bottom: 60rpx; }
.offscreen-canvas { position: fixed; left: -9999rpx; top: -9999rpx; width: 10rpx; height: 10rpx; }
.tabs { display: flex; background: #fff; border-bottom: 1rpx solid #eee; position: sticky; top: 0; z-index: 10; }
.tab { flex: 1; text-align: center; padding: 28rpx 0; font-size: 28rpx; color: #8A8F99; }
.tab.active { color: #07C160; font-weight: 600; border-bottom: 4rpx solid #07C160; }
.loading { text-align: center; padding: 120rpx; color: #999; font-size: 28rpx; }
.card { background: #fff; margin: 24rpx; border-radius: 20rpx; padding: 32rpx; }
.section-title { font-size: 30rpx; font-weight: 600; color: #222; margin-bottom: 24rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.section-head .section-title { margin-bottom: 0; }
.add-btn { font-size: 28rpx; color: #07C160; padding: 8rpx 20rpx; }
.field { margin-bottom: 24rpx; }
.field.half { width: 48%; }
.field-row { display: flex; justify-content: space-between; }
.label { font-size: 26rpx; color: #666; margin-bottom: 12rpx; }
.req { color: #e64340; }
.input { width: 100%; box-sizing: border-box; background: #F7F8FA; border-radius: 12rpx; height: 88rpx; padding: 0 24rpx; font-size: 28rpx; color: #222; }

/* 截止时间选择器 */
.label-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.label-row .label { margin-bottom: 0; }
.clear-btn { font-size: 24rpx; color: #e64340; padding: 4rpx 12rpx; }
.picker-row { display: flex; justify-content: space-between; }
.picker-half { width: 48%; }
.picker-input { width: 100%; box-sizing: border-box; background: #F7F8FA; border-radius: 12rpx; height: 88rpx; padding: 0 24rpx; font-size: 28rpx; color: #222; display: flex; align-items: center; }
.picker-input.ph { color: #b2b7bf; }
.tip-inline { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.save-btn { background: #07C160; color: #fff; font-size: 30rpx; border-radius: 14rpx; margin: 24rpx; font-weight: 600; }
.save-btn.small { display: inline-block; width: 45%; margin: 0; }
.cancel-btn { background: #fff; color: #666; font-size: 30rpx; border-radius: 14rpx; margin: 12rpx 24rpx; border: 1rpx solid #ddd; }
.cancel-btn.small { display: inline-block; width: 45%; margin: 0; }
.btn-row { display: flex; justify-content: space-between; margin-top: 20rpx; }
.tip { font-size: 24rpx; color: #999; line-height: 1.7; margin: 16rpx 24rpx; }
.tip.center { text-align: center; }
.store-item { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.store-item:last-child { border-bottom: none; }
.store-main { flex: 1; min-width: 0; }
.store-name { font-size: 28rpx; font-weight: 600; color: #222; }
.store-meta { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.store-ops { display: flex; flex-direction: column; gap: 16rpx; margin-left: 20rpx; }
.op { font-size: 26rpx; color: #07C160; }
.op.danger { color: #e64340; }
.empty-inline { text-align: center; color: #bbb; font-size: 26rpx; padding: 48rpx 0; }
.poster-preview { width: 100%; border-radius: 12rpx; }
.toast { position: fixed; left: 50%; bottom: 80rpx; transform: translateX(-50%); background: rgba(0,0,0,.8); color: #fff; font-size: 28rpx; padding: 20rpx 36rpx; border-radius: 12rpx; z-index: 100; white-space: nowrap; }
