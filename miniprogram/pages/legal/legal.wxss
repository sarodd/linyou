.page { min-height:100vh; background:#fff; padding:36rpx 40rpx 80rpx; box-sizing:border-box; }
.empty { text-align:center; color:#999; padding:160rpx 0; font-size:28rpx; }
.doc-head { padding-bottom:28rpx; border-bottom:1rpx solid #eee; }
.doc-title { font-size:40rpx; font-weight:600; color:#222; }
.doc-meta { font-size:22rpx; color:#aaa; margin-top:12rpx; }
.doc-intro { font-size:26rpx; color:#666; line-height:1.75; margin:28rpx 0 8rpx; }
.section { margin-top:36rpx; }
.section-h { font-size:29rpx; font-weight:600; color:#222; margin-bottom:14rpx; }
.section-p { font-size:26rpx; color:#555; line-height:1.8; margin-bottom:10rpx; }
.mail { color:#07C160; }
.foot { font-size:22rpx; color:#bbb; margin-top:56rpx; text-align:center; }
