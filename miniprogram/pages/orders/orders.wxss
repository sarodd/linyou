.page { min-height:100vh; background:#f6f7f9; padding:20rpx 0 140rpx; }
/* 首次无管理员时的一次性引导条 */
.boot-card { background:#fff; margin:0 24rpx 20rpx; border-radius:16rpx; padding:26rpx 28rpx; }
.boot-tip { font-size:24rpx; color:#999; line-height:1.6; }
.boot-btn { margin-top:16rpx; background:#07C160; color:#fff; text-align:center; font-size:27rpx; padding:18rpx; border-radius:10rpx; }
.boot-btn.disabled { opacity:.55; }
.loading { text-align:center; color:#999; padding:120rpx 0; }
.empty { text-align:center; padding:160rpx 0; }
.empty-icon { width:120rpx; height:120rpx; line-height:120rpx; border-radius:50%; background:#eee; color:#bbb; font-size:48rpx; margin:0 auto 24rpx; }
.empty-text { color:#999; font-size:28rpx; }
.btn-sm { display:inline-block; margin-top:30rpx; background:#07C160; color:#fff; font-size:26rpx; padding:16rpx 40rpx; border-radius:8rpx; }
.order { background:#fff; margin:0 24rpx 20rpx; border-radius:16rpx; padding:28rpx; }
.order-head { display:flex; justify-content:space-between; align-items:center; padding-bottom:18rpx; border-bottom:1rpx solid #f2f2f2; }
.store { font-size:28rpx; font-weight:600; color:#333; }
.status { font-size:24rpx; padding:6rpx 16rpx; border-radius:20rpx; }
.status-paid { color:#ff8c00; background:#fff5e6; }
.status-verified { color:#07C160; background:#e8f8ee; }
.status-cancelled { color:#999; background:#f2f2f2; }
.status-cancel_processing { color:#e64545; background:#fdecec; }
.order-body { padding:20rpx 0; }
.goods { font-size:30rpx; color:#333; }
.order-no { font-size:23rpx; color:#999; margin-top:12rpx; }
.created { font-size:23rpx; color:#bbb; margin-top:6rpx; }
.order-foot { display:flex; justify-content:space-between; align-items:center; padding-top:18rpx; border-top:1rpx solid #f2f2f2; }
.invite-tag { font-size:22rpx; color:#07C160; background:#e8f8ee; padding:6rpx 14rpx; border-radius:8rpx; }
.amount { font-size:28rpx; color:#333; font-weight:600; }
